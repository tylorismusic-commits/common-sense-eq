@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix idpy: <http://harrisonconsoles.com/lv2/inlinedisplay#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

@prefix cse: <https://github.com/tylorismusic-commits/common-sense-eq> .

<https://github.com/tylorismusic-commits/common-sense-eq>
	a lv2:Plugin , lv2:EQPlugin ;
	lv2:binary <common-sense-eq.so> ;
	lv2:majorVersion 0 ;
	lv2:minorVersion 1 ;
	lv2:microVersion 0 ;
	lv2:project <https://github.com/tylorismusic-commits/common-sense-eq> ;
	lv2:optionalFeature lv2:hardRTCapable , idpy:queue_draw , idpy:in_gui ;
	lv2:extensionData idpy:interface ;
	doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
	doap:name "Common Sense EQ" ;
	doap:description "Eight-band channel EQ with dynamic bands, an analyzer, and inline mixer-strip displays." ;
	doap:shortdesc "Dynamic 8-band channel EQ with inline displays." ;
	foaf:homepage <https://github.com/tylorismusic-commits/common-sense-eq> ;
	ui:ui <https://github.com/tylorismusic-commits/common-sense-eq#ui> ;
	lv2:port
		[
			a lv2:AudioPort , lv2:InputPort ;
			lv2:index 0 ;
			lv2:symbol "in_l" ;
			lv2:name "Input Left" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#input> ;
			lv2:designation pg:left ;
		] ,
		[
			a lv2:AudioPort , lv2:InputPort ;
			lv2:index 1 ;
			lv2:symbol "in_r" ;
			lv2:name "Input Right" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#input> ;
			lv2:designation pg:right ;
		] ,
		[
			a lv2:AudioPort , lv2:OutputPort ;
			lv2:index 2 ;
			lv2:symbol "out_l" ;
			lv2:name "Output Left" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#output> ;
			lv2:designation pg:left ;
		] ,
		[
			a lv2:AudioPort , lv2:OutputPort ;
			lv2:index 3 ;
			lv2:symbol "out_r" ;
			lv2:name "Output Right" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#output> ;
			lv2:designation pg:right ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 4 ;
			lv2:symbol "enable" ;
			lv2:name "Enabled" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#global> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer , lv2:toggled ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 5 ;
			lv2:symbol "output_gain" ;
			lv2:name "Output Gain" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#global> ;
			lv2:default 0 ;
			lv2:minimum -24 ;
			lv2:maximum 24 ;
			units:unit units:db ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 6 ;
			lv2:symbol "analyzer_mode" ;
			lv2:name "Analyzer" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#global> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer , lv2:enumeration ;
			lv2:scalePoint [ rdfs:label "PRE" ; rdf:value 0 ] ;
			lv2:scalePoint [ rdfs:label "POST" ; rdf:value 1 ] ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 7 ;
			lv2:symbol "q_couple" ;
			lv2:name "Q-Couple" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#global> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer , lv2:toggled ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 8 ;
			lv2:symbol "processing" ;
			lv2:name "Processing" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#global> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 3 ;
			lv2:portProperty lv2:integer , lv2:enumeration ;
			lv2:scalePoint [ rdfs:label "STEREO" ; rdf:value 0 ] ;
			lv2:scalePoint [ rdfs:label "MONO" ; rdf:value 1 ] ;
			lv2:scalePoint [ rdfs:label "LEFT" ; rdf:value 2 ] ;
			lv2:scalePoint [ rdfs:label "RIGHT" ; rdf:value 3 ] ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 9 ;
			lv2:symbol "low_cut_on" ;
			lv2:name "Low Cut On" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#band1> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer , lv2:toggled ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 10 ;
			lv2:symbol "low_cut_freq" ;
			lv2:name "Low Cut Frequency" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#band1> ;
			lv2:default 20 ;
			lv2:minimum 20 ;
			lv2:maximum 20000 ;
			units:unit units:hz ;
			lv2:portProperty lv2:logarithmic ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 11 ;
			lv2:symbol "low_cut_gain" ;
			lv2:name "Low Cut Gain" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#band1> ;
			lv2:default 0 ;
			lv2:minimum -30 ;
			lv2:maximum 30 ;
			units:unit units:db ;
		] ,
		[
			a lv2:ControlPort , lv2:InputPort ;
			lv2:index 12 ;
			lv2:symbol "low_cut_q" ;
			lv2:name "Low Cut Q" ;
			pg:group <https://github.com/tylorismusic-commits/common-sense-eq#band1> ;
			lv2:default 0.71 ;
			lv2:minimum 0.1 ;
			lv2:maximum 25 ;
			lv2:portProperty lv2:logarithmic ;
		] ,
